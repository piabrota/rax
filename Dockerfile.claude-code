# Task image with Claude Code preinstalled, a port of AX's
# Dockerfile.claude-code.
#
# Extends the rax-task-runner image and replaces its runner with
# rax-claude-code-runner (crates/rax-claude-code-runner), installed at the
# same /usr/local/bin/ax-task-runner path. A Task that leaves spec.command
# empty is configured through spec.config, which holds the prompt and
# claude's flags: the runner turns it into a headless `claude --print`
# session. A Task that sets spec.command runs it as usual.
#
#   just claude-code-image                          # builds rax-task-runner:local first
#   docker build -f Dockerfile.claude-code \
#     --build-arg CLAUDE_CODE_VERSION=2.1.310 -t rax-claude-code .
#
# Pin the pushed digest in your Task's spec.image; Substrate rejects
# tag-only references. See examples/claude-code/task.yaml.
#
# Build on a linux/amd64 host (or in CI). The installer executes the
# downloaded binary to finish setup, and that binary aborts under qemu
# emulation, so cross-building for amd64 on Apple Silicon fails.

# The runner image this extends: `just runner-image` builds it, or pass a
# pushed rax-task-runner (or AX ax-task-runner) image.
ARG BASE_IMAGE=rax-task-runner:local

FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p rax-claude-code-runner && \
    cp target/release/rax-claude-code-runner /rax-claude-code-runner

FROM ${BASE_IMAGE}

# Claude Code's native installer ships a standalone binary, so no Node.js is
# needed. "latest", "stable", or an exact version such as 2.1.310.
ARG CLAUDE_CODE_VERSION=latest

# The installer puts the launcher in ~/.local/bin and versioned binaries in
# ~/.local/share/claude. Install as root (the task runs as root) and expose
# the launcher on the default PATH so spec.command can call `claude` directly.
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}" \
    && ln -s /root/.local/bin/claude /usr/local/bin/claude \
    && claude --version

# The sandbox is the isolation boundary, so headless runs use
# --dangerously-skip-permissions. Claude Code refuses that flag when running
# as root unless IS_SANDBOX is set.
ENV IS_SANDBOX=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1

COPY --from=build /rax-claude-code-runner /usr/local/bin/ax-task-runner
RUN ln -sf ax-task-runner /usr/local/bin/rax-claude-code-runner
ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
